<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE labels SYSTEM "https://resources.jetbrains.com/writerside/1.0/labels-list.dtd">
<labels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/labels.xsd">
    <primary-label id="jdbc" short-name="" name="JDBC" color="blue">
        仅 JDBC
    </primary-label>

    <primary-label id="r2dbc" short-name="" name="R2DBC" color="purple">
        仅 R2DBC
    </primary-label>
    <primary-label id="experimental" name="实验性" short-name="实验性" color="tangerine">
        此功能为实验性功能，可能随时被移除或更改。使用前必须显式选择启用（详见下文）。
    </primary-label>
</labels>
